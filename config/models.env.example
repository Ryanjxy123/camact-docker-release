# 真实地址、模型名放本机 config/models.env；不要提交。密钥放外部 Secrets 文件。
AGENT_MODEL=replace-with-agent-model
AGENT_BASE_URL=https://agent.example.invalid/v1
AGENT_TIMEOUT_SECONDS=600
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_PARAMETERS={}
# 各官方 CLI 保留其原生协议；同一网关必须提供所需端点，或分别覆盖地址。
AGENT_PROTOCOL_BASELINE=openai-chat
AGENT_PROTOCOL_CLAUDE=anthropic-messages
AGENT_PROTOCOL_CODEX=openai-responses
AGENT_PROTOCOL_OPENCODE=anthropic-messages
AGENT_PROTOCOL_DEEPSEEK=deepseek-messages
AGENT_PROTOCOL_OPENCLAW=anthropic-messages
# 例：AGENT_BASE_URL_CODEX=https://codex.example.invalid/v1
# 例：AGENT_MODEL_CLAUDE=replace-with-another-model
# 例：AGENT_API_KEY_FILE_CODEX=/run/secrets/another_key（需自行添加 secret 挂载）
JUDGE_MODEL=replace-with-judge-model
JUDGE_BASE_URL=https://judge.example.invalid/v1
JUDGE_PROTOCOL=openai-chat
JUDGE_TIMEOUT_SECONDS=120
JUDGE_MAX_OUTPUT_TOKENS=8192
JUDGE_PARAMETERS={}
SIMULATOR_MODEL=replace-with-simulator-model
SIMULATOR_BASE_URL=https://simulator.example.invalid/v1
SIMULATOR_PROTOCOL=openai-chat
SIMULATOR_TIMEOUT_SECONDS=600
SIMULATOR_MAX_OUTPUT_TOKENS=8192
SIMULATOR_PARAMETERS={}
BENCHMARK_REPO=Ryanjxy/CamAct-Benchmark
BENCHMARK_COMMIT=53e2f450042485dfc4a3b566de6f46988c3a5661
